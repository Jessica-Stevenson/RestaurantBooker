@model dynamic

@{
    ViewData["Title"] = "Desserts & Beverages";
}

<div class="menu-container">
    <h1 class="menu-section-title">DESSERTS</h1>
    <div class="menu-items-grid">
        <div class="menu-item">
            <img src="/images/molten-lava-cake.jpg" alt="Molten Lava Cake" class="item-image" />
            <h3 class="item-name">Molten Lava Cake</h3>
            <p class="item-description">A warm, decadent chocolate cake with a gooey center, served with a scoop of vanilla bean ice cream.</p>
        </div>
        <div class="menu-item">
            <img src="/images/creme-brulee.jpg" alt="Creme Brulee" class="item-image" />
            <h3 class="item-name">Creme Brulee</h3>
            <p class="item-description">Rich custard topped with a layer of hardened caramelized sugar.</p>
        </div>
        <div class="menu-item">
            <img src="/images/cheesecake.jpg" alt="New York Cheesecake" class="item-image" />
            <h3 class="item-name">New York Cheesecake</h3>
            <p class="item-description">Classic, creamy cheesecake with a graham cracker crust, topped with your choice of berry compote or chocolate sauce.</p>
        </div>
    </div>

    <h1 class="menu-section-title">BEVERAGES</h1>
    <div class="menu-items-grid">
        <div class="menu-item">
            <img src="/images/soft-drinks.jpg" alt="Soft Drinks" class="item-image" />
            <h3 class="item-name">Soft Drinks</h3>
            <p class="item-description">Coke, Coke Zero, Fanta, Sprite</p>
        </div>
        <div class="menu-item">
            <img src="/images/lemonade.jpg" alt="Lemonade" class="item-image" />
            <h3 class="item-name">Lemonade</h3>
            <p class="item-description">Lemon Lime & Bitters</p>
        </div>
        <div class="menu-item">
            <img src="/images/juices.jpg" alt="Juices" class="item-image" />
            <h3 class="item-name">Juices</h3>
            <p class="item-description">Orange Juice, Grapefruit, Apple Juice</p>
        </div>
        <div class="menu-item">
            <img src="/images/hot-drinks.jpg" alt="Hot Drinks" class="item-image" />
            <h3 class="item-name">Hot Drinks</h3>
            <p class="item-description">Tea, Coffee</p>
        </div>
        <div class="menu-item">
            <img src="/images/alcoholic-beverages.jpg" alt="Alcoholic Beverages" class="item-image" />
            <h3 class="item-name">Alcoholic Beverages</h3>
            <p class="item-description">Wines, Beers, Spirits, Cocktails</p>
        </div>
    </div>
</div>