@{
    ViewData["Title"] = "Reservation";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 text-primary">Welcome to RestaurantBooker</h1>
        <p class="lead text-muted">Where cozy vibes meet delicious dining.</p>
        <a href="/Reservation/Create" class="btn btn-outline-primary btn-lg mt-3">Book a Table</a>
    </div>

    <div class="row text-center">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Explore Our Menu</h5>
                    <p class="card-text">From comfort food to candlelit dinners, see what’s cooking.</p>
                    <a href="/Menu" class="btn btn-sm btn-primary">View Menu</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Login or Register</h5>
                    <p class="card-text">Join our community and manage your reservations with ease.</p>
                    <a href="/Login" class="btn btn-sm btn-primary me-2">Login</a>
                    <a href="/Register" class="btn btn-sm btn-outline-secondary">Register</a>
                </div>
            </div>
        </div>
    </div>
</div>
