@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RestaurantBooker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RestaurantBooker.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm custom-colour box-shadow mb-3 fixed-top" ">

            <div class="container-fluid">

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">RestaurantBooker</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Reservation" asp-action="Create">Reservation</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Menu" asp-action="Index">Menu</a>
                        </li>

                        <ul class="navbar-nav ms-auto">

							@* show user info if logged in *@
                            <ul class="navbar-nav ms-auto">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <li class="nav-item">

                                        @{
                                            var currentUser = await UserManager.GetUserAsync(User);
                                        }

                                        @* say hello to user with their Name *@
                                        <span class="nav-link">Hello @currentUser?.FirstName @currentUser?.LastName!</span>
                                    </li>

                                  

                                    <li class="nav-item">
                                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" class="form-inline">
                                            <button type="submit" class="btn btn-danger">Logout</button>
                                        </form>
                                    </li>


                                }

                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link me-2" asp-area="Identity" asp-page="/Account/Login">Login</a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
                                    </li>
                                }

                            </ul>



                        </ul>

                    </ul>
                </div>
            </div>
        </nav>

    </header>
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

    <footer class="custom-colour border-top footer">

        <div class="container">
            &copy; 2025 - RestaurantBooker - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>


    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
