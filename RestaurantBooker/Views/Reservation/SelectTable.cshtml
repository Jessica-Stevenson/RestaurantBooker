@model RestaurantBooker.Models.SelectTableViewModel

<h2 class="text-center fw-bold mb-4">Select Your Table</h2>

@{
    // group tables by location
    var groupedTables = Model.Tables.GroupBy(t => t.Location);
}

<div class="container">
    @foreach (var group in groupedTables)
    {
        <div class="mb-5">
            <h3 class="mb-3 text-secondary text-center">@group.Key</h3>

            <div class="d-flex flex-wrap justify-content-center gap-3">
                @foreach (var table in group)
                {
                    var statusClass = table.IsAvailable ? "available" : "taken";

                    <div class="table-card @(table.IsAvailable ? "available" : "taken")"
                         data-id="@table.Id"
                         onclick="@(table.IsAvailable
                                         ? $"selectTable({table.Id})"
                                         : "alert('This table cannot be selected (too small or already booked).')")">
                        <p><strong>Table @table.Id</strong></p>
                        <p>Seats: @table.Capacity</p>
                    </div>

                }
            </div>
        </div>
    }
</div>

<!-- Reservation Form -->
<form method="post" asp-action="ConfirmReservation" asp-controller="Reservation" class="text-center mt-4">
    <input type="hidden" id="formTableId" name="TableId" />

    <!-- Hidden reservation fields -->
    <input type="hidden" name="Id" value="@Model.Reservation.Id" />
    <input type="hidden" name="Name" value="@Model.Reservation.Name" />
    <input type="hidden" name="Email" value="@Model.Reservation.Email" />
    <input type="hidden" name="Phone" value="@Model.Reservation.Phone" />
    <input type="hidden" name="Date" value="@Model.Reservation.Date.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="Time" value="@Model.Reservation.Time" />
    <input type="hidden" name="NumberOfGuests" value="@Model.Reservation.NumberOfGuests" />
    <input type="hidden" name="SpecialRequests" value="@Model.Reservation.SpecialRequests" />

    <button type="submit" class="btn btn-danger mt-3">Confirm Reservation</button>
</form>

<!-- Navigation -->
<div class="text-center mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-danger">Home</a>
</div>

<!-- Legend -->
<div class="text-center mt-4">
    <span class="legend-box available"></span> Available
    <span class="legend-box taken ms-3"></span> Taken
    <span class="legend-box selected ms-3"></span> Selected
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mt-3 text-center">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<script>
    let selectedId = null;

    function selectTable(id) {
        selectedId = id;
        document.getElementById("formTableId").value = id;

        // remove "selected" from all cards
        document.querySelectorAll(".table-card").forEach(card => {
            card.classList.remove("selected");
        });

        // highlight selected card
        document.querySelector(`.table-card[data-id='${id}']`).classList.add("selected");
    }
</script>