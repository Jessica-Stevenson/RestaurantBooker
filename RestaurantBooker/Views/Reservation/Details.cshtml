@model RestaurantBooker.Models.Reservation

<div class="container py-5" style="background-color: #F8E4E4; border-radius: 12px; max-width: 600px;">
    <h2 class="text-center text-primary mb-4">Reservation Confirmed</h2>

    <div class="card shadow p-4">
        <p><strong>Name:</strong> @Model.Name</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Phone:</strong> @Model.Phone</p>
        <p><strong>Date:</strong> @Model.Date.ToString("dddd, dd MMM yyyy")</p>
        <p><strong>Time:</strong> @Model.Time</p>
        <p><strong>Number of Guests:</strong> @Model.NumberOfGuests</p>
        <p><strong>Table:</strong> Table @Model.Table?.Id (@Model.Table?.Location, Seats @Model.Table?.Capacity)</p>
        <p><strong>Special Requests:</strong> @Model.SpecialRequests</p>
    </div>

    <div class="text-center mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>

    </div>
</div>
